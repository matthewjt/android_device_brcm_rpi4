import /vendor/etc/init/hw/init.${ro.hardware}.usb.rc

on init
    symlink /sdcard /storage/sdcard0

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

# GPIO21 (physical pin 40) is what the Pi firmware samples at power-on to pick the
# initramfs. Export it once early so the recovery trigger only has to drive it low.
# init's built-in write/reboot run in the init domain: no SELinux domain transition
# needed (init's 'exec' of /system/bin/sh fails outright - no init->shell transition).
on early-boot
    write /sys/class/gpio/export 21

# Request TWRP on the next boot: drive GPIO21 low, then reboot.
# The "Raspberry Pi settings" app writes sys.rpi.recovery=1 for exactly this;
# it can also be triggered by hand: adb shell setprop sys.rpi.recovery 1
on property:sys.rpi.recovery=1
    write /sys/class/gpio/gpio21/direction out
    write /sys/class/gpio/gpio21/value 0
    setprop sys.powerctl reboot

# Same action as sent by KangTvSettingsTwoPanel's "Restart to recovery" button
# (SystemProperties.set("sys.rpi.recovery","recovery") in KonstaKANG's RebootConfirmFragment).
on property:sys.rpi.recovery=recovery
    write /sys/class/gpio/gpio21/direction out
    write /sys/class/gpio/gpio21/value 0
    setprop sys.powerctl reboot
