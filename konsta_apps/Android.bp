// Soong prebuilt overrides for the Android TV Settings apps.
//
// WHY soong and not kati filter-out: the stock apps are added to PRODUCT_PACKAGES by
// device/google/atv/products/atv_system_ext.mk (via atv_base.mk inherit); inherited
// packages are appended to OUR file AFTER our filter-out runs, so kati cannot remove
// them (attempt 6 proved it: filter-out present, TvSettings still installed).
//
// Module-type properties proven from THIS tree's soong source (build/soong/java/app_import.go):
//   - "prebuilt_apk" is Android.mk-ONLY (unrecognized module type in .bp).
//   - android_app_import takes the source as `apk:` (Apk Configurable[string], line 111),
//     NOT `src:`; it has NO `installable` property; `overrides` is a BaseModuleProperties
//     field (android/module.go:568) and suppresses the overridden module's install.
//
// BOTH stock modules declare the SAME package com.android.tv.settings:
//   - TvSettingsTwoPanel  (the app Kang patched)
//   - TvSettings          (classic TV settings, added by atv_system_ext.mk:29)
// Our import is KonstaKANG's PATCHED TvSettingsTwoPanel (platform re-signed):
//   "Raspberry Pi settings" row in Device preferences + "Restart to recovery"
//   (sys.rpi.recovery=recovery -> GPIO21 -> TWRP).
// A duplicate package = PMS fatal install failure = boot loop, so EXACTLY ONE
// APK may be installed: Kang's, once. This module overrides BOTH stock sources
// (TwoPanel + classic) -> whichever the product selects is suppressed, and this
// single prebuilt installs once. (A second Kang module would install the same
// package a second time - a single overriding module is the correct shape.)
//
// The APK is ALREADY signed with the AOSP platform test key -> certificate: "presigned".

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// certificate: "presigned" references an android_app_certificate module named
// "presigned" (soong app.go:1954: <certificate>.x509.pem/.pk8 next to the .bp).
// ninja fails 'presigned.x509.pem missing' without it (attempt 9, 00:53). The
// presigned path copies the APK AS-IS (no re-sign); the files are our platform
// test-keys (the Kang APK is already signed with them - consistent, and the
// presigned apk verifier checks signature/alignment against the target).
android_app_certificate {
    name: "presigned",
    certificate: "presigned",
}

android_app_import {
    name: "KangTvSettingsTwoPanel",
    apk: "TvSettingsTwoPanel-kang.apk",
    certificate: "presigned",
    overrides: ["TvSettingsTwoPanel", "TvSettings"],
    system_ext_specific: true,
    privileged: true,
    compile_multilib: "64",
}
