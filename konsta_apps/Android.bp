// KonstaKANG apps imported presigned (keeps original signatures).
// RRO overlay APKs are shipped via PRODUCT_COPY_FILES in device.mk (product/overlay).

android_app_import {
    name: "DeviceSettings",
    apk: "DeviceSettings.apk",
    presigned: true,
    privileged: true,
}

android_app_import {
    name: "LineageCustomizer",
    apk: "LineageCustomizer.apk",
    presigned: true,
    privileged: true,
    product_specific: true,
}
