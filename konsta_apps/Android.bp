// Soong prebuilt overrides for the Android TV Settings apps.
//
// WHY soong and not kati filter-out: the stock apps are added to PRODUCT_PACKAGES by
// device/google/atv/products/atv_system_ext.mk (via atv_base.mk inherit); inherited
// packages are appended to OUR file AFTER our filter-out runs, so kati cannot remove
// them (attempt 6 proved it: filter-out present, TvSettings still installed).
//
// Module type note: "prebuilt_apk" is Android.mk-ONLY (soong bp-parser: unrecognized
// module type). In Android.bp the prebuilt-APK type is android_app_import. The
// replacement mechanism in .bp = overrides: [<source module>] (suppresses the source
// module's install) + installable:false (installs NOTHING) = supported suppression.
//
// BOTH stock modules declare the SAME package com.android.tv.settings:
//   - TvSettingsTwoPanel  (the app Kang patched)
//   - TvSettings          (classic TV settings, added by atv_system_ext.mk:29)
// Our import is KonstaKANG's PATCHED TvSettingsTwoPanel (platform re-signed):
//   "Raspberry Pi settings" row in Device preferences + "Restart to recovery"
//   (sys.rpi.recovery=recovery -> GPIO21 -> TWRP).
// A duplicate package = PMS fatal install failure = boot loop, so EXACTLY ONE
// install may exist: Kang's APK (installed as KangTvSettingsTwoPanel.apk in
// system_ext/priv-app/KangTvSettingsTwoPanel/). The classic slot installs nothing.
//
// The APK is ALREADY signed with the AOSP platform test key -> certificate: "presigned".

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Kang's patched TV Settings; overrides suppress the stock TwoPanel install.
android_app_import {
    name: "KangTvSettingsTwoPanel",
    src: "TvSettingsTwoPanel-kang.apk",
    certificate: "presigned",
    overrides: ["TvSettingsTwoPanel"],
    system_ext_specific: true,
    privileged: true,
    compile_multilib: "64",
    installable: true,
}

// Suppression stub: overrides removes the classic TvSettings from the install set;
// installable:false means NOTHING is installed for it (src is never installed).
// Net: zero copies of the classic app, exactly one com.android.tv.settings on device.
android_app_import {
    name: "KangTvSettingsClassic",
    src: "TvSettingsTwoPanel-kang.apk",
    certificate: "presigned",
    overrides: ["TvSettings"],
    system_ext_specific: true,
    privileged: true,
    installable: false,
}
