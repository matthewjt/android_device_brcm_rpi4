// Kang mainline DNS graft - member-level prebuilts from
// lineage-23.2-20260520-UNOFFICIAL-KonstaKANG (kang_apex payload on host, copied
// under kang/ here). Root cause of app-level net::ERR_INTERNET_DISCONNECTED /
// Netflix -11: Chromium "Failed to read DnsConfig" (dns_config_service_android.cc:81);
// Kang's May-2026 mainline delivers per-app DNS config on identical hw/network,
// our Aug-2026 mainline (netd_updatable/dns_helper/framework-connectivity-jni
// hash-differ) does not.
//
// Strategy: keep the SOURCE-built com.android.tethering/com.android.resolv apexes
// (no mainline-prebuilt visibility gates, dexpreopt/sscf/ABI flows stay native)
// and shadow exactly the DNS-chain member modules with Kang's binaries via
// prefer:true. See NOTES.md 2026-10-27/28.
cc_prebuilt_library_shared {
    name: "libnetd_updatable",
    compile_multilib: "64",
    src: "kang/libnetd_updatable.so",
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    shared_libs: ["libbase", "liblog", "libnetdutils", "libc++"],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libframework-connectivity-jni",
    compile_multilib: "64",
    src: "kang/libframework-connectivity-jni.so",
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    shared_libs: ["libandroid", "liblog", "libnativehelper"],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libframework-connectivity-tiramisu-jni",
    compile_multilib: "64",
    src: "kang/libframework-connectivity-tiramisu-jni.so",
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    shared_libs: ["libandroid", "liblog", "libnativehelper"],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libcom.android.tethering.dns_helper",
    compile_multilib: "64",
    src: "kang/libcom.android.tethering.dns_helper.so",
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    shared_libs: ["libbase", "libc++"],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libservice-connectivity",
    compile_multilib: "64",
    src: "kang/libservice-connectivity.so",
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libnetdutils",
        "liblog",
        "libnativehelper",
        "libnetworkstats",
        "libc++",
    ],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libnetd_resolv",
    compile_multilib: "64",
    src: "kang/libnetd_resolv.so",
    min_sdk_version: "30",
    apex_available: ["com.android.resolv"],
    shared_libs: [
        "libbinder_ndk",
        "libcrypto",
        "liblog",
        "libssl",
        "libstatssocket",
    ],
    prefer: true,
}

java_import {
    name: "service-connectivity",
    jars: ["kang/service-connectivity.jar"],
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    prefer: true,
}

java_sdk_library_import {
    name: "framework-connectivity",
    jars: ["kang/framework-connectivity.jar"],
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    prefer: true,
}

java_sdk_library_import {
    name: "framework-connectivity-t",
    jars: ["kang/framework-connectivity-t.jar"],
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    prefer: true,
}

java_sdk_library_import {
    name: "framework-connectivity-b",
    jars: ["kang/framework-connectivity-b.jar"],
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    prefer: true,
}

java_sdk_library_import {
    name: "framework-tethering",
    jars: ["kang/framework-tethering.jar"],
    min_sdk_version: "30",
    apex_available: ["com.android.tethering"],
    prefer: true,
}
