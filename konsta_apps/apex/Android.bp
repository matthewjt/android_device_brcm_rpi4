// Kang's known-good mainline apexes (lineage-23.2-20260520).
// Root cause of app-level net::ERR_INTERNET_DISCONNECTED / Netflix -11 on our
// build: Chromium's "Failed to read DnsConfig" (dns_config_service_android.cc:81).
// Kang (May-2026 mainline) delivers per-app DNS config fine on identical hardware
// and network; our Aug-2026 mainline (netd_updatable/dns_helper/connectivity-jni
// all hash-differ) does not. Graft Kang's tethering + resolv apexes, overriding
// the source-built equivalents. See NOTES.md 2026-10-27.
prebuilt_apex {
    name: "com.android.tethering-kang",
    apex_name: "com.android.tethering",
    // source_apex_name: BaseModuleName() = apex_name = early-exits the
    // mainline-prebuilt visibility gate (prebuilt.go:758) and wires prefer:true
    // to shadow the source apex. Without it the module is hidden from make
    // (mainline prebuilt "not flagged") -> 'non-existent modules in PRODUCT_PACKAGES'.
    source_apex_name: "com.android.tethering",
    src: "com.android.tethering@361099999.apex",
    filename: "com.android.tethering.apex",
    installable: true,
    // prefer: true = this prebuilt wins over the source apex (soong
    // overridable-module machinery); with only overrides: the prebuilt is
    // hidden from make -> "non-existent modules in PRODUCT_PACKAGES".
    prefer: true,
    overrides: ["com.android.tethering"],
    // Wires the source systemserverclasspath fragment to THIS prebuilt so soong
    // dexpreopts service-connectivity.jar deapexed from Kang's payload; without it
    // dex_preopt_check fails (missing apex@com.android.tethering@...odex/.vdex).
    // apex_name is REQUIRED: dexpreoptSystemServerJars matches on it (defaults to
    // module name "com.android.tethering-kang" = no match = no odex).
    exported_systemserverclasspath_fragments: ["com.android.tethering-systemserverclasspath-fragment"],
}

prebuilt_apex {
    name: "com.android.resolv-kang",
    apex_name: "com.android.resolv",
    source_apex_name: "com.android.resolv",
    src: "com.android.resolv@361099999.apex",
    filename: "com.android.resolv.apex",
    installable: true,
    prefer: true,
    overrides: ["com.android.resolv"],
}
